# CAT_ADMIN_DEFAULT_PASSWORD=admin123

# Protect endpoints with an access token
# CAT_API_KEY=meow

# self reload during development
# CAT_DEBUG=true

# Log levels
# CAT_LOG_LEVEL=INFO

# CORS
# CAT_CORS_ALLOWED_ORIGINS is also the allow-list for cookie (`jwt=`) authentication: a cookie coming from any
# other cross-site Origin (HTTP or WebSocket) is ignored. List here the origins of your frontends (e.g. the admin).
# CAT_CORS_ENABLED=true
# CAT_CORS_ALLOWED_ORIGINS=https://example.org,https://www.example.org
# Comma separated list of IPs to trust with proxy headers. A wildcard '*' means always trust.
# CAT_CORS_FORWARDED_ALLOW_IPS="*"

# Redis server
# CAT_REDIS_HOST=<host>
# CAT_REDIS_PORT=6379
# CAT_REDIS_DB=<optional_db>
# CAT_REDIS_PASSWORD=<optional_password>
# CAT_REDIS_TLS=true

# JWT (JSON Web Token) settings: secret key and expiration time in minutes
# REQUIRED: the app refuses to start (and /health reports unhealthy) if missing, a known default or < 32 chars.
# Generate it with: python -c "import secrets; print(secrets.token_urlsafe(64))"
CAT_JWT_SECRET=<your_jwt_secret>
# CAT_JWT_EXPIRE_MINUTES=15
# Refresh token: idle lifetime and absolute session lifetime (minutes)
# CAT_JWT_REFRESH_EXPIRE_MINUTES=10080
# CAT_JWT_REFRESH_MAX_LIFETIME_MINUTES=43200

# Brute-force protection on /auth/token and /auth/refresh (fixed window, shared via Redis)
# CAT_AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# CAT_AUTH_MAX_ATTEMPTS_PER_IP=30
# CAT_AUTH_MAX_FAILURES_PER_USER=10
# CAT_AUTH_MAX_REFRESH_PER_IP=120

# Uvicorn and FastAPI operating behind https proxy
# CAT_HTTPS_PROXY_MODE=true

# Set the expiration time for the history conversation in the Redis storage
# CAT_HISTORY_EXPIRATION=30

# Set the values to encrypt / decrypt privacy data
# CAT_CRYPTO_KEY=<your_cryptography_key>
# CAT_CRYPTO_SALT=<your_cryptography_salt>

# Document ingestion
# Max concurrent ingestion bodies in flight process-wide (0 disables). Default: 2
# CAT_INGESTION_MAX_CONCURRENCY=2
# Dedicated ingestion thread pool size (0 disables -> shared default pool). Default: 2
# CAT_INGESTION_WORKERS=2
# nice value (0-19) that lowers the ingestion workers' CPU priority (0 disables). Default: 5
# CAT_INGESTION_NICENESS=5
# Periodic resume sweep interval in seconds (0 disables). Default: 60
# CAT_INGESTION_RESUME_INTERVAL_SECONDS=60
# Heartbeat interval that keeps a processing ingestion row fresh. Default: 30
# CAT_INGESTION_HEARTBEAT_SECONDS=30